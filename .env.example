# Copy to .env beside docker-compose.yml. This file holds only the two
# values Compose substitutes into the configuration. The sign-in and the
# session key go in secrets.env, because Compose reads a $ in this file as
# the start of a variable and a scrypt hash is full of them.

# The address the site answers on.
PHARMASEARCH_DOMAIN=search.example.com

# Where Let's Encrypt writes about the certificate.
TLS_EMAIL=you@example.com
