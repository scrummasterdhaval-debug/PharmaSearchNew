# Copy to secrets.env beside docker-compose.yml and fill in. Keep it off
# git and off email: anyone who reads it can sign in as the admin.
# Values here are passed to the application as written, $ included.

# The admin sign-in. Print the hash with, from Backend/:
#   python tools/make_admin_password.py <username>
PHARMASEARCH_ADMIN_USERNAME=admin
PHARMASEARCH_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...$...

# Signs session cookies. Changing it signs everyone out. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PHARMASEARCH_SESSION_SECRET=

# Regulator API credentials. Optional: a source whose credentials are unset
# is skipped, and every other source still runs.
# United Kingdom (MHRA product search index query key)
MHRA_SEARCH_API_KEY=
# Ireland (medicines.ie API client)
MEDICINES_IE_CLIENT_ID=
MEDICINES_IE_CLIENT_SECRET=
